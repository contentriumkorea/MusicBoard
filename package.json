{
  "name": "sono",
  "productName": "MusicBoard",
  "version": "0.1.11",
  "private": true,
  "type": "module",
  "description": "PulseDeck: a local music player for macOS and Windows",
  "author": {
    "name": "Contentrium",
    "url": "https://github.com/contentriumkorea"
  },
  "homepage": "https://github.com/contentriumkorea/MusicBoard",
  "repository": {
    "type": "git",
    "url": "https://github.com/contentriumkorea/MusicBoard.git"
  },
  "main": "dist-electron/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "pnpm test && pnpm typecheck && pnpm build",
    "verify:interactions": "node scripts/delete-smoke.mjs && node scripts/drop-smoke.mjs && node scripts/organize-smoke.mjs && node scripts/playback-smoke.mjs && node scripts/smoke.mjs && node scripts/update-smoke.mjs && node scripts/features-smoke.mjs && node scripts/long-waveform-smoke.mjs && node scripts/trim-smoke.mjs && node scripts/waveform-fade-smoke.mjs && node scripts/mislabeled-audio-smoke.mjs && node scripts/loop-smoke.mjs && node scripts/branding-smoke.mjs",
    "verify:features": "node scripts/features-smoke.mjs",
    "verify:waveform": "node scripts/long-waveform-smoke.mjs",
    "verify:trim": "node scripts/trim-smoke.mjs",
    "verify:mac-update": "node scripts/mac-update-smoke.mjs",
    "verify:update": "node scripts/update-smoke.mjs --packaged",
    "pack:win": "pnpm build && electron-builder --win --dir",
    "pack:mac": "pnpm build && electron-builder --mac --dir",
    "release:win": "pnpm build && electron-builder --win nsis --x64 --publish never && node scripts/legacy-release.mjs",
    "release:mac": "pnpm build && electron-builder --mac --universal --publish never && node scripts/legacy-release.mjs",
    "verify:waveform-fade": "node scripts/waveform-fade-smoke.mjs",
    "verify:mislabeled-audio": "node scripts/mislabeled-audio-smoke.mjs",
    "verify:loop": "node scripts/loop-smoke.mjs",
    "verify:branding": "node scripts/branding-smoke.mjs",
    "verify:legacy-mac-update": "node scripts/mac-update-smoke.mjs --legacy"
  },
  "build": {
    "appId": "local.luma.music",
    "productName": "MusicBoard",
    "publish": {
      "provider": "github",
      "owner": "contentriumkorea",
      "repo": "MusicBoard",
      "releaseType": "release"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "resources/**/*",
      "package.json"
    ],
    "mac": {
      "identity": "-",
      "artifactName": "MusicBoard-${version}-mac-${arch}.${ext}",
      "icon": "resources/icon.icns",
      "category": "public.app-category.music",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "resources/icon.ico",
      "artifactName": "MusicBoard-${version}-windows-${arch}-setup.${ext}",
      "target": [
        "nsis"
      ],
      "executableName": "SONO"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "shortcutName": "MusicBoard"
    },
    "afterPack": "scripts/after-pack.cjs"
  },
  "dependencies": {
    "electron-updater": "6.8.0",
    "lucide-react": "^1.49.0",
    "mediabunny": "1.61.0",
    "music-metadata": "^11.16.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
